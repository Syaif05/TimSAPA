{
  "manifest_version": 3,
  "name": "SAPA • Gunakan Tab WhatsApp",
  "version": "1.4.0",
  "description": "Membuka draf SAPA di tab WhatsApp Web yang sudah ada tanpa membuat tab baru.",
  "permissions": ["scripting"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://timsapa.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Status koneksi SAPA dan WhatsApp", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://timsapa.vercel.app/*"],
    "js": ["content.js"]
  }]
}
